# このファイルを .env にコピーしてローカル開発用の値を入れてください。
# Renderにデプロイする場合は .env は使わず、Renderダッシュボードの
# Environment に同じキーで設定します。

# Kick Developer API (https://kick.com/developer)
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Gemini APIキー(未設定でもドックUIから後で設定可能)
GEMINI_API_KEY=

# ポート(Renderは自動設定するため通常は不要。ローカルでのみ上書きしたい場合に指定)
# PORT=3941
